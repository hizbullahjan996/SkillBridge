# ============================================
# SkillBridge Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# --- App ---
APP_NAME=SkillBridge API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillbridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=skillbridge

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (React) ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- ML Model ---
ML_MODEL_PATH=../ml/models/skillbridge_career_classifier.joblib

# --- LLM (AI Career Assistant) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
